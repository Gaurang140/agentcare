# AgentCare configuration
# Copy this file to .env. Keep every credential value in .env or the
# deployment secret store, never in version control.

# Model profile from backend/llm.yaml.
# Accepted values: groq | local | vertex
# Empty also selects the file default, groq.
LLM_PROFILE=groq

# Optional field-level overrides for the selected profile.
# Leave these commented to use backend/llm.yaml. An empty value still counts
# as an environment override, so do not uncomment either variable empty.
# Groq and local profiles use OpenAI-compatible endpoints.
# LLM_BASE_URL=https://your-compatible-endpoint/v1
# LLM_MODEL=your-provider-model
LLM_API_KEY=

# Vertex profile
# The vertex profile uses Google Application Default Credentials (ADC), not
# an API key in this file. For local use, create ADC with:
#   gcloud auth application-default login
# The Google GenAI integration reads these standard environment variables.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west3

# Optional fallback endpoint, tried once after primary transport retries.
# A local server usually needs no fallback key.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Optional prompt-injection classifier. Model Armor takes precedence when
# MODEL_ARMOR_TEMPLATE is set. Empty values leave deterministic screening on.
INJECTION_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
MODEL_ARMOR_TEMPLATE=
MODEL_ARMOR_LOCATION=europe-west3

# Database and LangGraph checkpoints
# SQLite uses a separate raw checkpoint file. Postgres stores checkpoints in
# the configured server/database and ignores CHECKPOINT_DB_PATH.
DATABASE_URL=sqlite:///./agentcare.db
CHECKPOINT_DB_PATH=checkpoints.db

# Optional Langfuse tracing. Empty values disable tracing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Authentication and internal jobs
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
INTERNAL_TASK_TOKEN=

# Document storage
# Accepted STORAGE_BACKEND values: local | gcs
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
GCS_BUCKET=

# Application
ENVIRONMENT=dev
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
