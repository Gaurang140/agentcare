# AgentCare configuration. Copy to .env; credentials live only in .env or the
# deployment secret store, never in version control.
# Quick start: set LLM_API_KEY and JWT_SECRET, leave the rest as is.

# Model profile from backend/llm.yaml: groq | local | vertex (empty = groq).
LLM_PROFILE=groq

# Optional overrides for the selected profile. Leave commented to use
# backend/llm.yaml; an empty value still counts as an override.
# LLM_BASE_URL=https://your-compatible-endpoint/v1
# LLM_MODEL=your-provider-model
LLM_API_KEY=

# Vertex profile uses Application Default Credentials, not an API key here.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=europe-west3

# Optional fallback endpoint, tried once after primary transport retries.
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=

# Optional prompt-injection classifier. Model Armor takes precedence when
# MODEL_ARMOR_TEMPLATE is set; deterministic screening always stays on.
INJECTION_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
MODEL_ARMOR_TEMPLATE=
MODEL_ARMOR_LOCATION=europe-west3

# Database and LangGraph checkpoints. Postgres ignores CHECKPOINT_DB_PATH.
DATABASE_URL=sqlite:///./agentcare.db
CHECKPOINT_DB_PATH=checkpoints.db

# Optional Langfuse tracing: disabled unless both keys are set and the sample
# rate is above zero.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
LANGFUSE_SAMPLE_RATE=0
APP_RELEASE=

# Authentication and internal jobs. Generate JWT_SECRET with:
#   openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
INTERNAL_TASK_TOKEN=

# Document storage: local | gcs
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
GCS_BUCKET=

# Application
ENVIRONMENT=dev
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
