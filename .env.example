# LLM (OpenAI-compatible). Cloud: Groq free tier. Local: LM Studio.
# Model defaults live in backend/llm.yaml as named profiles; the env vars
# here override fields of the active profile.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_key_here
LLM_MODEL=openai/gpt-oss-120b
# Named profile from backend/llm.yaml (groq | local). Empty uses the
# file's default_profile (groq). Other providers can be added as profiles
# once their langchain package is installed and smoke-tested (see the
# commented gemini example in backend/llm.yaml).
LLM_PROFILE=
# Optional second-layer prompt-injection classifier
# (backend/app/safety/injection_guard.py). This is a Groq preview model;
# it is only called when LLM_API_KEY is also set. Leave empty to run the
# deterministic pattern layer alone.
INJECTION_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m
# Google Model Armor, the GCP provider for that same layer-2 slot and for a
# screen of the drafted answer (backend/app/safety/model_armor.py). Empty
# disables the layer: nothing off GCP calls it and the deterministic layer
# runs alone. Set it to the full template path
# projects/PROJECT/locations/LOCATION/templates/ID (terraform output
# model_armor_template_name) and give the calling service account
# roles/modelarmor.user. When both this and INJECTION_GUARD_MODEL are set,
# Model Armor takes the slot.
MODEL_ARMOR_TEMPLATE=
MODEL_ARMOR_LOCATION=europe-west3
# Optional fallback endpoint, tried once if the primary exhausts its
# retries. Local: LM Studio at http://localhost:1234/v1 (no key needed).
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
# Database. Default SQLite needs no setup; docker-compose overrides with Postgres.
DATABASE_URL=sqlite:///./agentcare.db
# LangGraph checkpoints: separate sqlite file from the app db (raw file
# path, not a URL). Ignored when DATABASE_URL is postgres.
CHECKPOINT_DB_PATH=checkpoints.db
# Langfuse tracing (optional). Leave both keys empty to disable.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
# Auth
JWT_SECRET=change_me_generate_a_long_random_string
JWT_EXPIRE_MINUTES=1440
# Internal task token for POST /api/internal/reminders/run-due (X-Internal-Token
# header). Leave empty to require a staff login cookie instead.
INTERNAL_TASK_TOKEN=
# Storage: local | gcs
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
GCS_BUCKET=
# App
ENVIRONMENT=dev
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
